{
  "name": "magazine",
  "version": "0.1.0",
  "description": "Magazine-style theme — bolder colors, serif headings, left sidebar.",
  "author": "Mortar Team",
  "settings": {
    "primary_color": "#dc2626",
    "background": "#fafaf9",
    "text_color": "#1c1917",
    "link_color": "#dc2626",
    "heading_font": "serif",
    "body_font": "system",
    "sidebar_position": "left",
    "posts_per_row": "1",
    "heading_cap": "1",
    "heading_max": "30"
  },
  "custom_css": "article { border-radius: 12px; } .widget-title { letter-spacing: 0.05em; }",
  "settingsSchema": [
    {
      "key": "header_layout",
      "label": "Header Layout",
      "type": "select",
      "options": [
        "centered",
        "left"
      ],
      "default": "centered"
    },
    {
      "key": "show_lead_story",
      "label": "Show lead story card",
      "type": "checkbox",
      "default": "1"
    },
    {
      "key": "banner_text",
      "label": "Masthead banner text",
      "type": "text",
      "default": ""
    },
    {
      "key": "footer_note",
      "label": "Footer note",
      "type": "textarea",
      "default": "Thank you for reading."
    }
  ]
}
