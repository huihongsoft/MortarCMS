{
  "name": "mortar",
  "version": "0.1.0",
  "private": true,
  "description": "A WordPress-like CMS built with TypeScript",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:admin\" \"npm run dev:frontend\"",
    "dev:server": "cd server && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:server && npm run build:admin && npm run build:frontend",
    "build:server": "cd server && npm run build",
    "build:admin": "cd admin && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd server && npm start",
    "lint": "eslint \"server/src/**/*.ts\" \"admin/src/**/*.{ts,tsx}\" \"frontend/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
