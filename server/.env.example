# Database driver (default: SQLite at server/data/mortar.db)
# To use MySQL or PostgreSQL, set DATABASE_URL:
# DATABASE_URL=mysql://user:password@localhost:3306/mortar
# DATABASE_URL=postgres://user:password@localhost:5432/mortar

# JWT secret (REQUIRED in production — the server refuses to start without it)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=change-me-to-a-long-random-string

# Trust the X-Forwarded-For header (set to 1 only when running behind a
# reverse proxy like nginx). Required for correct client IPs / rate limits.
# TRUST_PROXY=1

# CORS: comma-separated list of extra cross-origin origins allowed to call the
# API (same-origin and the site_url are always allowed)
# CORS_ORIGINS=https://app.example.com

# Server port
# PORT=3001

# Log verbosity: trace|debug|info|warn|error|fatal (default: info in production,
# debug otherwise). Logs are JSON in production and carry a request id.
# LOG_LEVEL=info

# SQLite database file (default: server/data/mortar.db). Point it at a mounted
# volume, not at a path inside the image.
# MORTAR_DB_PATH=/app/server/data/mortar.db

# Where backup archives and pre-migration snapshots are written (default:
# server/backups). Put it on different storage than the database if you can —
# a backup on the same disk only protects against operator error.
# MORTAR_BACKUPS_DIR=/mnt/backups/mortar
